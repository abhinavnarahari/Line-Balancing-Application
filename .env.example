# ==============================================================================
# SewNex Line Balancing & Smart Factory Platform - Environment Configuration
# ==============================================================================

# Application Port Settings
PORT=8085
FRONTEND_PORT=80
FRONTEND_ALT_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=qtech_linebalancing
POSTGRES_USER=postgres
# REQUIRED: use a long random password, e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432

# Spring Boot Datasource (username/password are taken from POSTGRES_USER/POSTGRES_PASSWORD)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/qtech_linebalancing

# Timezone used to decide what "today" is (attendance, production, hourly screens)
APP_TIMEZONE=Asia/Kolkata

# Re-create today's sample attendance & production rows every day (demo only; set false for real factory data)
DEMO_DATA_DAILY_REFRESH=true

# Flyway Migration Settings (Automatic Sample Data & Schema Initialization)
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_OUT_OF_ORDER=true

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*

# Optional External AI Assistant / Chatbot Integration
LLM_API_KEY=YOUR_GEMINI_OR_LLM_API_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
