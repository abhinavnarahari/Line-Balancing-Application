# ==============================================================================
# SewNex Line Balancing & Smart Factory Platform - Environment Configuration
# ==============================================================================

# Application Port Settings
PORT=8085
FRONTEND_PORT=80
FRONTEND_ALT_PORT=3000

# PostgreSQL Database Configuration
POSTGRES_DB=qtech_linebalancing
POSTGRES_USER=postgres
# REQUIRED: use a long random password, e.g. output of: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_PORT=5432

# Spring Boot Datasource (username/password are taken from POSTGRES_USER/POSTGRES_PASSWORD)
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/qtech_linebalancing

# First System Administrator account, created on first start when no users exist.
# REQUIRED: sign in with these, then create the other users under Settings -> User Accounts.
APP_ADMIN_EMAIL=admin@sewnexa.local
APP_ADMIN_PASSWORD=CHANGE_ME_8plus_chars_with_digit1

# Set to true after enabling HTTPS (session cookie becomes Secure)
SESSION_COOKIE_SECURE=false

# Timezone used to decide what "today" is (attendance, production, hourly screens)
APP_TIMEZONE=Asia/Kolkata

# Re-create today's sample attendance & production rows every day. Demo only: keep false for real factory data.
DEMO_DATA_DAILY_REFRESH=false

# Flyway migrations run automatically in strict mode. Set to true for ONE start only if the app
# refuses to start with "Migration checksum mismatch" (repairs flyway_schema_history, not data).
FLYWAY_REPAIR_ON_START=false

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=*

# Optional External AI Assistant / Chatbot Integration
LLM_API_KEY=YOUR_GEMINI_OR_LLM_API_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
